<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="iconPickerDialog"
    title="Choose an Icon"
    contentWidth="640px"
    contentHeight="70%"
    resizable="false"
    draggable="false">

    <subHeader>
      <Toolbar>
        <SearchField
          placeholder="Search icons (e.g. user, money, chart)"
          liveChange=".onIconSearch"
          width="100%"/>
      </Toolbar>
    </subHeader>

    <content>
      <ScrollContainer height="100%" vertical="true" horizontal="false">
        <HBox wrap="Wrap" justifyContent="Start" items="{ui>/iconPicker/filtered}" class="sapUiSmallMargin szIconGrid">
          <items>
            <VBox
              alignItems="Center"
              justifyContent="Center"
              class="szIconTile"
              width="80px"
              height="84px">
              <core:Icon
                src="{ui>}"
                size="1.6rem"
                color="#0a6ed1"
                press=".onIconChosen"
                tooltip="{ui>}"
                hoverColor="#0854a0"
                class="szIconTileIcon"/>
              <Text text="{= ${ui>}.replace('sap-icon://','') }" class="szIconTileLabel" maxLines="1"/>
            </VBox>
          </items>
        </HBox>
      </ScrollContainer>
    </content>

    <buttons>
      <Button text="Close" press=".onCloseIconPicker"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>

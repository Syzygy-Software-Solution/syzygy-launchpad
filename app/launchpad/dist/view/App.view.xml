<mvc:View
  controllerName="syzygylaunchpad.controller.App"
  xmlns="sap.m"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:tnt="sap.tnt"
  xmlns:core="sap.ui.core"
  xmlns:l="sap.ui.layout"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  displayBlock="true"
  height="100%">

  <tnt:ToolPage id="toolPage" sideExpanded="{ui>/sideExpanded}">

    <tnt:header>
      <tnt:ToolHeader>
        <Button
          icon="sap-icon://menu2"
          type="Transparent"
          press=".onSideToggle"
          tooltip="Toggle navigation"/>
        <Title text="{i18n>shellTitle}" level="H1" class="sapUiTinyMarginBegin"/>

        <ToolbarSpacer/>

        <SearchField
          id="globalSearch"
          placeholder="Search (Coming Soon)"
          width="280px"
          search=".onGlobalSearch"
          class="szGlobalSearch"/>

        <ToolbarSpacer/>

        <Button
          id="aiBotBtn"
          icon="sap-icon://ai"
          type="Transparent"
          tooltip="AI Assistant"
          press=".onOpenAiBot"
          class="szAiBotButton sapUiTinyMarginEnd"/>

        <Button
          icon="sap-icon://bell"
          type="Transparent"
          tooltip="Notifications"
          press=".onOpenNotifications"
          class="sapUiTinyMarginEnd">
          <customData>
            <BadgeCustomData value="4" visible="true"/>
          </customData>
        </Button>

        <HBox alignItems="Center" class="szUserBlock sapUiTinyMarginBegin sapUiTinyMarginEnd">
          <VBox alignItems="End" class="sapUiTinyMarginEnd szUserText">
            <Text text="{= 'Hello, ' + ${ui>/user/name} }" class="szUserName"/>
            <Text text="{ui>/user/role}" class="szUserRole"/>
          </VBox>
          <Avatar
            initials="{ui>/user/initials}"
            backgroundColor="Accent6"
            displaySize="S"
            press=".onUserPress"
            ariaHasPopup="Menu"/>
        </HBox>
      </tnt:ToolHeader>
    </tnt:header>

    <tnt:sideContent>
      <tnt:SideNavigation
        id="sideNav"
        expanded="{ui>/sideExpanded}"
        selectedKey="{ui>/selectedNavKey}"
        itemSelect=".onNavItemSelect">

        <tnt:NavigationList id="mainNavList">
          <tnt:NavigationListItem
            key="home"
            text="{i18n>home}"
            icon="sap-icon://home"
            select=".onSelectHome"/>

          <tnt:NavigationListGroup
            text="Your Apps"
            expanded="true"
            items="{
              path: '/ConfiguredApps',
              sorter: { path: 'sortOrder' },
              parameters: {
                '$filter': 'enabled eq true',
                '$select': 'appId,displayName,runtimeUrl,appVersion,iconUri,appType,sortOrder'
              }
            }">
            <tnt:NavigationListItem
              key="{appId}"
              text="{displayName}"
              icon="{= ${iconUri} || 'sap-icon://grid' }"
              select=".onSelectApp"/>
          </tnt:NavigationListGroup>
        </tnt:NavigationList>

        <tnt:fixedItem>
          <tnt:NavigationList>
            <tnt:NavigationListItem
              key="auditLogs"
              text="Audit Logs"
              icon="sap-icon://document-text"
              select=".onSelectAuditLogs"/>
            <tnt:NavigationListItem
              key="administration"
              text="Administration"
              icon="sap-icon://shield"
              select=".onSelectAdmin"/>
          </tnt:NavigationList>
        </tnt:fixedItem>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <tnt:mainContents>
      <HBox id="mainLayout" height="100%" renderType="Bare" class="szMainLayout">

        <NavContainer id="mainNav" defaultTransitionName="show" class="szMainNavContainer">
          <layoutData><FlexItemData growFactor="1" shrinkFactor="1" minWidth="0px"/></layoutData>

        <Page id="homePage" showHeader="false" class="szHomePage sapUiNoContentPadding">
          <VBox class="szHomeContent">

            <!-- greeting -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom szHomeGreeting">
              <VBox>
                <Title text="{= 'Good day, ' + ${ui>/user/name} }" level="H2"/>
                <Text text="Here's what's happening across your sales platform today." class="szHomeSubtitle"/>
              </VBox>
              <Button
                text="{i18n>homeManageCta}"
                icon="sap-icon://add"
                type="Emphasized"
                press=".onOpenManageDialog"/>
            </HBox>

            <!-- KPI tiles row -->
            <l:Grid defaultSpan="L3 M6 S12" hSpacing="1" vSpacing="1" containerQuery="true" class="sapUiSmallMarginBottom">
              <f:Card class="szKpiCard">
                <f:header>
                  <card:Header
                    title="Total Commissions"
                    subtitle="MTD"
                    iconSrc="sap-icon://money-bills"
                    statusText="+12.4%"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="$2.84M" level="H1" class="szKpiValue"/>
                    <Text text="vs $2.53M last month" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>

              <f:Card class="szKpiCard">
                <f:header>
                  <card:Header
                    title="Active Partners"
                    subtitle="This quarter"
                    iconSrc="sap-icon://customer"
                    statusText="+5"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="148" level="H1" class="szKpiValue"/>
                    <Text text="of 162 onboarded" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>

              <f:Card class="szKpiCard">
                <f:header>
                  <card:Header
                    title="Quota Attainment"
                    subtitle="FY tracking"
                    iconSrc="sap-icon://target-group"
                    statusText="On track"
                    statusVisible="true"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="78%" level="H1" class="szKpiValue"/>
                    <ProgressIndicator percentValue="78" displayValue="78% of $42M target" state="Success" class="sapUiSmallMarginTop"/>
                  </VBox>
                </f:content>
              </f:Card>

              <f:Card class="szKpiCard">
                <f:header>
                  <card:Header
                    title="Open Disputes"
                    subtitle="Awaiting review"
                    iconSrc="sap-icon://alert"
                    statusText="3 urgent"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="11" level="H1" class="szKpiValue"/>
                    <Text text="Avg. resolution: 2.3 days" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>
            </l:Grid>

            <!-- content cards -->
            <l:Grid defaultSpan="L6 M12 S12" hSpacing="1" vSpacing="1" containerQuery="true">

              <!-- Partner commissions card -->
              <f:Card class="szContentCard">
                <f:header>
                  <card:Header
                    title="Partner Commissions"
                    subtitle="Top earners — last 30 days"
                    iconSrc="sap-icon://group"/>
                </f:header>
                <f:content>
                  <List showSeparators="Inner" class="szPlainList">
                    <StandardListItem title="Acme Corp"            description="North America"  info="$184,200" infoState="Success"/>
                    <StandardListItem title="Globex Solutions"     description="EMEA"           info="$142,800" infoState="Success"/>
                    <StandardListItem title="Initech Holdings"     description="APAC"           info="$118,540" infoState="Success"/>
                    <StandardListItem title="Umbrella Industries"  description="LATAM"          info="$96,100"  infoState="None"/>
                    <StandardListItem title="Stark Resellers"      description="North America"  info="$84,330"  infoState="None"/>
                  </List>
                </f:content>
              </f:Card>

              <!-- Territory & Quota card -->
              <f:Card class="szContentCard">
                <f:header>
                  <card:Header
                    title="Territory &amp; Quota"
                    subtitle="Coverage by region"
                    iconSrc="sap-icon://map-2"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <VBox class="sapUiTinyMarginBottom">
                      <HBox justifyContent="SpaceBetween"><Text text="North America"/><Text text="92%"/></HBox>
                      <ProgressIndicator percentValue="92" state="Success"/>
                    </VBox>
                    <VBox class="sapUiTinyMarginBottom">
                      <HBox justifyContent="SpaceBetween"><Text text="EMEA"/><Text text="76%"/></HBox>
                      <ProgressIndicator percentValue="76" state="Success"/>
                    </VBox>
                    <VBox class="sapUiTinyMarginBottom">
                      <HBox justifyContent="SpaceBetween"><Text text="APAC"/><Text text="64%"/></HBox>
                      <ProgressIndicator percentValue="64" state="Warning"/>
                    </VBox>
                    <VBox class="sapUiTinyMarginBottom">
                      <HBox justifyContent="SpaceBetween"><Text text="LATAM"/><Text text="48%"/></HBox>
                      <ProgressIndicator percentValue="48" state="Error"/>
                    </VBox>
                  </VBox>
                </f:content>
              </f:Card>

              <!-- Dashboards card -->
              <f:Card class="szContentCard">
                <f:header>
                  <card:Header
                    title="Dashboards"
                    subtitle="Saved views you visit often"
                    iconSrc="sap-icon://business-objects-experience"/>
                </f:header>
                <f:content>
                  <List showSeparators="Inner" class="szPlainList">
                    <StandardListItem title="Pipeline Health"        description="Updated 2h ago"  icon="sap-icon://line-chart"   type="Active"/>
                    <StandardListItem title="Commission Forecast"    description="Updated 5h ago"  icon="sap-icon://bar-chart"    type="Active"/>
                    <StandardListItem title="Rep Leaderboard"        description="Updated today"   icon="sap-icon://podcast"      type="Active"/>
                    <StandardListItem title="Channel Performance"    description="Updated 1d ago"  icon="sap-icon://pie-chart"    type="Active"/>
                  </List>
                </f:content>
              </f:Card>

              <!-- Activity card -->
              <f:Card class="szContentCard">
                <f:header>
                  <card:Header
                    title="Recent Activity"
                    subtitle="Across all apps"
                    iconSrc="sap-icon://history"/>
                </f:header>
                <f:content>
                  <List showSeparators="Inner" class="szPlainList">
                    <StandardListItem title="Q2 commission run completed"            description="Partner Commissions • 1h ago"   icon="sap-icon://accept"   iconInset="false"/>
                    <StandardListItem title="New territory plan published"           description="Territory &amp; Quota • 3h ago" icon="sap-icon://map-2"    iconInset="false"/>
                    <StandardListItem title="3 disputes flagged for review"          description="Partner Commissions • 6h ago"   icon="sap-icon://alert"    iconInset="false"/>
                    <StandardListItem title="FY26 quotas approved by leadership"     description="Territory &amp; Quota • 1d ago" icon="sap-icon://approvals" iconInset="false"/>
                    <StandardListItem title="Pipeline Health dashboard refreshed"    description="Dashboards • 1d ago"            icon="sap-icon://refresh"  iconInset="false"/>
                  </List>
                </f:content>
              </f:Card>

            </l:Grid>
          </VBox>
        </Page>

        <Page id="appPage" showHeader="false" enableScrolling="false" class="szAppPage">
          <core:HTML id="appFrameHost" content="&lt;div class='szAppFrameHost'&gt;&lt;/div&gt;"/>
          <BusyIndicator
            id="frameBusy"
            visible="{ui>/frameLoading}"
            size="3rem"
            class="szFrameBusy"/>
        </Page>

        <!-- ═══ Audit Logs Page ═══ -->
        <Page id="auditLogsPage" showHeader="false" class="szAuditPage sapUiNoContentPadding">
          <VBox class="szAuditContent">

            <!-- page heading -->
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom szAuditHeader">
              <VBox>
                <Title text="Audit Trail" level="H2"/>
                <Text text="Track all user actions and data changes across the platform." class="szHomeSubtitle"/>
              </VBox>
              <DateRangeSelection
                id="auditHeaderDateRange"
                displayFormat="dd-MMM-yyyy"
                placeholder="Select date range"
                required="true"
                dateValue="{ui>/audit/dateFrom}"
                secondDateValue="{ui>/audit/dateTo}"
                change=".onAuditDateRangeChange"
                class="szAuditHeaderDate"/>
            </HBox>

            <!-- KPI summary tiles (5 cards, equal-width flex) -->
            <HBox wrap="Wrap" class="szAuditKpiRow sapUiSmallMarginBottom">

              <f:Card class="szKpiCard szAuditKpiCard">
                <f:header>
                  <card:Header title="Total Audit Records" subtitle="{ui>/audit/kpis/totalSub}" iconSrc="sap-icon://document-text"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="{ui>/audit/kpis/total}" level="H1" class="szKpiValue"/>
                    <Text text="All audit records" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>

              <f:Card class="szKpiCard szAuditKpiCard">
                <f:header>
                  <card:Header title="Data Changes" subtitle="{ui>/audit/kpis/dataChangesSub}" iconSrc="sap-icon://edit"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="{ui>/audit/kpis/dataChanges}" level="H1" class="szKpiValue szKpiSuccess"/>
                    <Text text="Create / Update / Delete" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>

              <f:Card class="szKpiCard szAuditKpiCard">
                <f:header>
                  <card:Header title="Status Changes" subtitle="{ui>/audit/kpis/statusChangesSub}" iconSrc="sap-icon://synchronize"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="{ui>/audit/kpis/statusChanges}" level="H1" class="szKpiValue szKpiInfo"/>
                    <Text text="Workflow transitions" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>

              <f:Card class="szKpiCard szAuditKpiCard">
                <f:header>
                  <card:Header title="User Actions" subtitle="{ui>/audit/kpis/userActionsSub}" iconSrc="sap-icon://employee"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="{ui>/audit/kpis/userActions}" level="H1" class="szKpiValue szKpiWarning"/>
                    <Text text="Login / access events" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>

              <f:Card class="szKpiCard szAuditKpiCard">
                <f:header>
                  <card:Header title="Failed Actions" subtitle="{ui>/audit/kpis/failedActionsSub}" iconSrc="sap-icon://warning"/>
                </f:header>
                <f:content>
                  <VBox class="sapUiSmallMargin">
                    <Title text="{ui>/audit/kpis/failedActions}" level="H1" class="szKpiValue szKpiError"/>
                    <Text text="Errors and failures" class="szKpiHint"/>
                  </VBox>
                </f:content>
              </f:Card>

            </HBox>

            <!-- Filter panel (all filters + buttons in one flex row) -->
            <f:Card class="sapUiSmallMarginBottom szAuditFilterCard">
              <f:content>
                <HBox wrap="Wrap" alignItems="End" class="szAuditFilterRow">

                  <VBox>
                    <layoutData><FlexItemData growFactor="1" shrinkFactor="1" baseSize="0px" minWidth="160px"/></layoutData>
                    <Label text="Date Range *" design="Bold" required="true" class="sapUiTinyMarginBottom"/>
                    <DateRangeSelection
                      id="auditFilterDateRange"
                      displayFormat="dd-MMM-yyyy"
                      width="100%"
                      required="true"
                      dateValue="{ui>/audit/dateFrom}"
                      secondDateValue="{ui>/audit/dateTo}"
                      change=".onAuditDateRangeChange"/>
                  </VBox>

                  <VBox>
                    <layoutData><FlexItemData growFactor="1" shrinkFactor="1" baseSize="0px" minWidth="160px"/></layoutData>
                    <Label text="Application" design="Bold" class="sapUiTinyMarginBottom"/>
                    <Select id="auditFilterApp" width="100%" selectedKey="{ui>/audit/appFilter}">
                      <items>
                        <core:Item key="" text="All Applications"/>
                        <core:Item key="Syzygy Launchpad" text="Syzygy Launchpad"/>
                        <core:Item key="Commissions Accounting" text="Commissions Accounting"/>
                        <core:Item key="Partner Commissions" text="Partner Commissions"/>
                        <core:Item key="Objective Management" text="Objective Management"/>
                        <core:Item key="Master Data" text="Master Data"/>
                      </items>
                    </Select>
                  </VBox>

                  <VBox>
                    <layoutData><FlexItemData growFactor="1" shrinkFactor="1" baseSize="0px" minWidth="140px"/></layoutData>
                    <Label text="Module" design="Bold" class="sapUiTinyMarginBottom"/>
                    <Select id="auditFilterModule" width="100%" selectedKey="{ui>/audit/moduleFilter}">
                      <items>
                        <core:Item key="" text="All Modules"/>
                        <core:Item key="Authentication" text="Authentication"/>
                      </items>
                    </Select>
                  </VBox>

                  <VBox>
                    <layoutData><FlexItemData growFactor="1" shrinkFactor="1" baseSize="0px" minWidth="140px"/></layoutData>
                    <Label text="Action Type" design="Bold" class="sapUiTinyMarginBottom"/>
                    <Select id="auditFilterActionType" width="100%" selectedKey="{ui>/audit/actionTypeFilter}">
                      <items>
                        <core:Item key="" text="All Actions"/>
                        <core:Item key="LOGIN" text="Login"/>
                        <core:Item key="LOGOUT" text="Logout"/>
                        <core:Item key="CREATE" text="Create"/>
                        <core:Item key="UPDATE" text="Update"/>
                        <core:Item key="DELETE" text="Delete"/>
                        <core:Item key="STATUS_CHANGE" text="Status Change"/>
                        <core:Item key="APPROVE" text="Approve"/>
                        <core:Item key="UPLOAD" text="Upload"/>
                      </items>
                    </Select>
                  </VBox>

                  <VBox>
                    <layoutData><FlexItemData growFactor="1" shrinkFactor="1" baseSize="0px" minWidth="140px"/></layoutData>
                    <Label text="User" design="Bold" class="sapUiTinyMarginBottom"/>
                    <Select id="auditFilterUser" width="100%" selectedKey="{ui>/audit/userFilter}">
                      <items>
                        <core:Item key="" text="All Users"/>
                      </items>
                    </Select>
                  </VBox>

                  <VBox>
                    <layoutData><FlexItemData growFactor="1" shrinkFactor="1" baseSize="0px" minWidth="160px"/></layoutData>
                    <Label text="Entity Name / ID" design="Bold" class="sapUiTinyMarginBottom"/>
                    <Input id="auditFilterEntity" placeholder="Enter Entity Name / ID" width="100%" value="{ui>/audit/entityFilter}"/>
                  </VBox>

                  <HBox alignItems="Center" class="szAuditFilterBtns">
                    <layoutData><FlexItemData growFactor="0" shrinkFactor="0"/></layoutData>
                    <Button text="Reset" type="Default" press=".onAuditReset" class="sapUiTinyMarginEnd"/>
                    <Button text="Search" type="Emphasized" icon="sap-icon://search" press=".onAuditSearch"/>
                  </HBox>

                </HBox>
              </f:content>
            </f:Card>

            <!-- Audit Log table card -->
            <f:Card class="szAuditTableCard" busy="{ui>/audit/busy}" busyIndicatorDelay="200">
              <f:header>
                <card:Header
                  title="Audit Log"
                  subtitle="{= 'Showing ' + ${ui>/audit/items}.length + ' of ' + ${ui>/audit/totalCount} + ' records' }"/>
              </f:header>
              <f:content>
                <VBox>
                  <Table
                    id="auditLogsTable"
                    fixedLayout="false"
                    class="szAuditTable"
                    items="{ui>/audit/items}">
                    <columns>
                      <Column width="190px" hAlign="Begin"><Text text="Date &amp; Time"/></Column>
                      <Column width="170px" hAlign="Begin"><Text text="Application"/></Column>
                      <Column width="140px" hAlign="Begin"><Text text="Module"/></Column>
                      <Column width="160px" hAlign="Begin"><Text text="Entity Name"/></Column>
                      <Column width="170px" hAlign="Begin"><Text text="Entity ID"/></Column>
                      <Column width="130px" hAlign="Begin"><Text text="Action Type"/></Column>
                      <Column width="130px" hAlign="Begin"><Text text="Field Name"/></Column>
                      <Column width="180px" hAlign="Begin"><Text text="User"/></Column>
                      <Column width="110px" hAlign="Begin"><Text text="Status"/></Column>
                    </columns>
                    <ColumnListItem>
                      <cells>
                        <Text text="{ path: 'ui>EVENT_TIMESTAMP', formatter: '.formatAuditTimestamp' }"/>
                        <Text text="{ui>APPLICATION}"/>
                        <Text text="{ui>MODULE}"/>
                        <Text text="{ui>ENTITY_NAME}"/>
                        <Text text="{ui>ENTITY_ID}"/>
                        <Text text="{ui>ACTION_TYPE}"/>
                        <Text text="{ui>FIELD_NAME}"/>
                        <Text text="{ui>USER_NAME}"/>
                        <ObjectStatus
                          text="{ui>STATUS}"
                          state="{= ${ui>STATUS} === 'Success' ? 'Success' : (${ui>STATUS} === 'IdleTimeout' || ${ui>STATUS} === 'BrowserClose' ? 'Warning' : 'Error') }"/>
                      </cells>
                    </ColumnListItem>
                  </Table>

                  <!-- Pagination toolbar -->
                  <Toolbar class="szAuditPagerToolbar">
                    <Text text="{= 'Page ' + ${ui>/audit/page} + ' of ' + ${ui>/audit/totalPages} + ' \u00b7 ' + ${ui>/audit/totalCount} + ' records' }" class="szAuditPagerText"/>
                    <ToolbarSpacer/>
                    <Button
                      icon="sap-icon://media-rewind"
                      tooltip="First page"
                      type="Transparent"
                      enabled="{= ${ui>/audit/page} > 1 }"
                      press=".onAuditPageFirst"/>
                    <Button
                      icon="sap-icon://navigation-left-arrow"
                      tooltip="Previous page"
                      type="Transparent"
                      enabled="{= ${ui>/audit/page} > 1 }"
                      press=".onAuditPagePrev"/>
                    <Label text="Go to" class="sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
                    <Input
                      value="{ui>/audit/pageInput}"
                      width="64px"
                      type="Number"
                      submit=".onAuditPageGoto"
                      change=".onAuditPageGoto"/>
                    <Button
                      icon="sap-icon://navigation-right-arrow"
                      tooltip="Next page"
                      type="Transparent"
                      enabled="{= ${ui>/audit/page} &lt; ${ui>/audit/totalPages} }"
                      press=".onAuditPageNext"/>
                    <Button
                      icon="sap-icon://media-forward"
                      tooltip="Last page"
                      type="Transparent"
                      enabled="{= ${ui>/audit/page} &lt; ${ui>/audit/totalPages} }"
                      press=".onAuditPageLast"/>
                  </Toolbar>
                </VBox>
              </f:content>
            </f:Card>

          </VBox>
        </Page>

        <!-- ═══ Administration Page ═══ -->
        <Page id="adminPage" showHeader="false" class="szAdminPage">
          <VBox height="100%" justifyContent="Center" alignItems="Center" class="szAdminEmpty">
            <core:Icon src="sap-icon://shield" size="5rem" color="Default" class="sapUiMediumMarginBottom szAdminEmptyIcon"/>
            <Title text="Administration" level="H2" class="sapUiSmallMarginBottom"/>
            <Text text="System administration features are currently being built. Check back soon." textAlign="Center" class="szAdminEmptyText"/>
          </VBox>
        </Page>

        </NavContainer>

        <!-- AI chat side panel -->
        <VBox id="aiChatPanel" visible="{ui>/aiPanelOpen}" height="100%" class="szAiPanel">
          <layoutData><FlexItemData shrinkFactor="0" baseSize="380px"/></layoutData>

          <!-- header -->
          <Toolbar class="szAiPanelHeader sapMTB-Transparent-CTX">
            <Title text="AI Assistant" level="H4"/>
            <ToolbarSpacer/>
            <Button icon="sap-icon://decline" type="Transparent" tooltip="Close" press=".onCloseAiPanel"/>
          </Toolbar>

          <!-- illustrated placeholder -->
          <VBox class="szAiPanelBody" justifyContent="Center" alignItems="Center">
            <layoutData><FlexItemData growFactor="1" shrinkFactor="1" minWidth="0px"/></layoutData>
            <IllustratedMessage
              illustrationType="NoData"
              title="AI Assistant"
              description="Your intelligent copilot for Sales Performance insights. Chat functionality coming soon."/>
          </VBox>

          <!-- input bar -->
          <HBox alignItems="Center" class="szAiInputBar">
            <TextArea
              id="aiChatInput"
              placeholder="Ask me something..."
              growing="true"
              growingMaxLines="3"
              rows="1"
              class="szAiTextInput">
              <layoutData><FlexItemData growFactor="1" shrinkFactor="1" minWidth="0px"/></layoutData>
            </TextArea>
            <Button icon="sap-icon://microphone" type="Transparent" tooltip="Voice input" class="sapUiTinyMarginBegin"/>
            <Button icon="sap-icon://paper-plane" type="Emphasized" tooltip="Send" class="sapUiTinyMarginBegin"/>
          </HBox>
        </VBox>

      </HBox>
    </tnt:mainContents>
  </tnt:ToolPage>
</mvc:View>

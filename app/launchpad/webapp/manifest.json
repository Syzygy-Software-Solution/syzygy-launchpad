{
  "_version": "1.65.0",
  "sap.app": {
    "id": "syzygylaunchpad",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "launchpadService": {
        "uri": "/odata/v4/launchpad/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "syzygylaunchpad.view.App",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.136.5",
      "libs": {
        "sap.m": {},
        "sap.tnt": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.f": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "syzygylaunchpad.i18n.i18n" }
      },
      "": {
        "dataSource": "launchpadService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      },
      "ui": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "contentDensities": { "compact": true, "cozy": true },
    "resourceRoots": {
      "syzygylaunchpad": "./"
    }
  }
}

<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="adminCreateRoleCollectionDialog"
    title="Create Role Collection"
    contentWidth="520px"
    busy="{ui>/admin/newRoleCollection/busy}">

    <content>
      <VBox class="sapUiMediumMargin">
        <Text text="A new role collection will be created in this BTP subaccount. After it's created, attach role templates to it from the BTP cockpit (Security › Role Collections), then assign it to users from the User Management page." class="sapUiSmallMarginBottom"/>

        <Label text="Name *" design="Bold" required="true" class="sapUiTinyMarginBottom"/>
        <Input value="{ui>/admin/newRoleCollection/name}" placeholder="e.g. Buyer_Admin" class="sapUiSmallMarginBottom"/>

        <Label text="Description" design="Bold" class="sapUiTinyMarginBottom"/>
        <TextArea value="{ui>/admin/newRoleCollection/description}" rows="3" growing="true" placeholder="What does this role collection grant access to?"/>
      </VBox>
    </content>

    <beginButton>
      <Button text="Create" type="Emphasized" press=".onAdminCreateRoleCollectionSubmit"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onAdminCreateRoleCollectionCancel"/>
    </endButton>
  </Dialog>

</core:FragmentDefinition>

<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="adminCreateSecurityRoleDialog"
    title="Add New Role"
    contentWidth="520px"
    busy="{ui>/admin/security/newRole/busy}">

    <content>
      <VBox class="sapUiMediumMargin">
        <Text text="Create a new role. You can scope it to a single onboarded app or leave it as a common role that applies across all apps. Permissions can be assigned right after it's created." class="sapUiSmallMarginBottom"/>

        <Label text="Role name *" design="Bold" required="true" class="sapUiTinyMarginBottom"/>
        <Input value="{ui>/admin/security/newRole/roleName}" placeholder="e.g. Regional Approver" class="sapUiSmallMarginBottom"/>

        <Label text="Department" design="Bold" class="sapUiTinyMarginBottom"/>
        <Select
          forceSelection="false"
          selectedKey="{ui>/admin/security/newRole/department}"
          items="{ui>/admin/security/departments}"
          width="100%"
          class="sapUiSmallMarginBottom">
          <core:Item key="{ui>key}" text="{ui>text}"/>
        </Select>

        <Label text="Application scope" design="Bold" class="sapUiTinyMarginBottom"/>
        <Select
          forceSelection="false"
          selectedKey="{ui>/admin/security/newRole/appId}"
          items="{ui>/admin/security/apps}"
          width="100%"
          class="sapUiSmallMarginBottom">
          <core:Item key="{ui>appId}" text="{ui>displayName}"/>
        </Select>

        <Label text="Description" design="Bold" class="sapUiTinyMarginBottom"/>
        <TextArea value="{ui>/admin/security/newRole/description}" rows="3" growing="true" placeholder="What is this role for?"/>
      </VBox>
    </content>

    <beginButton>
      <Button text="Create Role" type="Emphasized" press=".onSecurityCreateRoleSubmit"/>
    </beginButton>
    <endButton>
      <Button text="Cancel" press=".onSecurityCreateRoleCancel"/>
    </endButton>
  </Dialog>

</core:FragmentDefinition>

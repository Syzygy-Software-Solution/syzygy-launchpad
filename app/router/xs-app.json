{
  "welcomeFile": "/syzygylaunchpad/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 30,
  "pluginMetadataEndpoint": "/pluginMetadata",
  "routes": [
    {
      "source": "^/odata/v4/launchpad/(.*)$",
      "target": "/odata/v4/launchpad/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^(/.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}

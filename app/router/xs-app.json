{
  "welcomeFile": "/syzygylaunchpad/index.html",
  "authenticationMethod": "route",
  "sessionTimeout": 10,
  "logout": {
    "logoutEndpoint": "/do/logout",
    "logoutPage": "/syzygylaunchpad/logout.html"
  },
  "pluginMetadataEndpoint": "/pluginMetadata",
  "routes": [
    {
      "source": "^/odata/v4/launchpad/(.*)$",
      "target": "/odata/v4/launchpad/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/syzygylaunchpad/logout.html$",
      "target": "/syzygylaunchpad/logout.html",
      "service": "html5-apps-repo-rt",
      "authenticationType": "none"
    },
    {
      "source": "^(/.*)$",
      "target": "$1",
      "service": "html5-apps-repo-rt",
      "authenticationType": "xsuaa"
    }
  ]
}

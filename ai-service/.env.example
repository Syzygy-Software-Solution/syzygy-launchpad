# Local-dev environment variables. Copy to .env and fill in for `uvicorn` runs.
# In Cloud Foundry these are injected via mta.yaml properties + VCAP_SERVICES.

# --- AI Core (Generative AI Hub) ---
GENAI_DESTINATION=aicore-genai
GENAI_CHAT_DEPLOYMENT_ID=dc26d22a85992d12
GENAI_CHAT_MODEL=gpt-4o-mini
GENAI_EMBED_DEPLOYMENT_ID=d19a1bf2fc3ac3eb
GENAI_EMBED_MODEL=text-embedding-3-small
AI_CORE_API_VERSION=2024-08-01-preview
AI_RESOURCE_GROUP=default

# --- SAP Incentive Management (via destination) ---
TCMP_DESTINATION=TCMP_DEST

# --- Service ---
LOG_LEVEL=INFO
# Set to "true" to skip JWT checks for local development only.
DEV_SKIP_AUTH=false

# --- Local dev fallback (used only when VCAP_SERVICES is not set) ---
# Raw JSON string of the AI Core service key.
# AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"https://...","serviceurls":{"AI_API_URL":"https://..."}}
